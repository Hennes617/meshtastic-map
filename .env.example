# Local Node.js processes
DATABASE_URL="mysql://root:change-this-password@127.0.0.1:3306/meshtastic-map?connection_limit=100"

# Docker Compose (copy this file to .env before starting)
MARIADB_DATABASE="meshtastic-map"
# Use URL-safe characters here because Compose inserts this value into a MySQL URL.
MARIADB_ROOT_PASSWORD="change-this-password"
DATABASE_PORT=3306
MAP_PORT=8081

# Optional process arguments
MAP_OPTS=""
# Leave blank to let the collector generate a collision-free client ID.
MQTT_OPTS=""
# MQTT_OPTS="--mqtt-client-id meshtastic-map-REPLACE-WITH-A-UNIQUE-HOSTNAME"

# Protobufs are fetched automatically by the Docker MQTT service when absent.
AUTO_FETCH_PROTOBUFS=true
# PROTOBUFS_GIT_REF="v2.7.0"
