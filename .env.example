DATABASE_URL="mysql://root@localhost:3306/meshtastic-map?connection_limit=100"
# For the public Meshtastic broker, use the regional topic root:
# MQTT_OPTS="--mqtt-client-id meshtastic-map-my-host --identity-source-url https://meshtastic.pugetmesh.org/api/v1/nodes --identity-source-url https://meshmap.ro/api/v1/nodes --identity-name-failsafe-url https://meshmap.net/nodes.json"
# The name/device failsafe also works on its own if you only want the meshmap.net backfill:
# MQTT_OPTS="--mqtt-client-id meshtastic-map-my-host --identity-name-failsafe-url https://meshmap.net/nodes.json"
MAP_PORT=8081
